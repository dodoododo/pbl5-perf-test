<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Job search read-only verification" enabled="true">
      <stringProp name="TestPlan.comments">Loopback only. One user, two GETs per loop, one second between requests. No credentials or response bodies saved.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="One sequential user" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(iterations,5)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Loopback HTTP defaults" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,4405)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">15000</stringProp>
        </ConfigTestElement>
        <hashTree/>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="One second pacing" enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
        </ConstantTimer>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Bound verification requests" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
def loops = props.getProperty('iterations', '5') as int
if (loops < 1 || loops > 10) {
  ctx.getThread().stop()
  throw new IllegalArgumentException('Use 1 to 10 loops for this low-load verification plan')
}
]]></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Exact total, response contract and disjoint pages" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
try {
  assert prev.getResponseCode() == '200'
  def data = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
  int page = prev.getSampleLabel() == 'search-page-1' ? 1 : 2
  assert data.keySet() == (['jobs','total','page','limit','filters'] as Set)
  assert data.page == page && data.limit == 10
  assert data.total instanceof Number && data.total >= 0
  assert data.jobs instanceof List && data.jobs.size() <= 10
  assert data.jobs.size() == Math.min(10, Math.max(0, data.total - (page - 1) * 10))
  assert data.filters.keySet() == (['categories','locations','jobTypes','programmingLanguages'] as Set)
  def fields = ['id','title','description','requirements','salary','salaryRange','location','workType','level','skills','isActive','createdDate','company','category','jobType'] as Set
  assert data.jobs.every { it.keySet() == fields && it.isActive == true }
  def ids = data.jobs.collect { it.id.toString() }
  assert ids.toSet().size() == ids.size()
  for (int index = 1; index < data.jobs.size(); index++) {
    def previous = data.jobs[index - 1]
    def current = data.jobs[index]
    def dateOrder = java.time.Instant.parse(previous.createdDate).compareTo(java.time.Instant.parse(current.createdDate))
    assert dateOrder > 0 || (dateOrder == 0 && previous.id > current.id)
  }
  def expected = props.getProperty('expectedTotal', '')
  if (expected) assert data.total.toString() == expected
  if (page == 1) {
    vars.putObject('page1Ids', ids.toSet())
    vars.put('page1Total', data.total.toString())
  } else {
    assert data.total.toString() == vars.get('page1Total')
    assert ids.every { !vars.getObject('page1Ids').contains(it) }
  }
} catch (Throwable ignored) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Search status, contract, total, order or pagination assertion failed; inspect privately')
}
]]></stringProp>
        </JSR223Assertion>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="search-page-1" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/jobs/search?q=Java&amp;page=1&amp;limit=10</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="search-page-2" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/jobs/search?q=Java&amp;page=2&amp;limit=10</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
